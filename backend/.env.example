# Database configuration (PostgreSQL or local SQLite)
DATABASE_URL=postgresql://privacyguard:privacyguard@postgres:5432/privacyguard_db
# For zero-config local run:
# DATABASE_URL=sqlite:///./privacyguard.db

# JWT & Security
JWT_SECRET=privacyguard_hackbios_shadow_secret_jwt_2026

# MobSF REST Integration
MOBSF_URL=http://mobsf:8000
MOBSF_API_KEY=

# Parent Alert Email Configuration (Gmail SMTP)
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Score Engine & Safety Thresholds
PARENT_ALERT_THRESHOLD=80
WEIGHT_ML=0.40
WEIGHT_STATIC=0.35
WEIGHT_HEURISTIC=0.25
MAX_APK_MB=150

# Web Application Origin
SITE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
